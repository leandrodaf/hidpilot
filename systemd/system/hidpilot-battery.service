[Unit]
Description=hidpilot: show Logitech device batteries in GNOME
Documentation=https://github.com/leandrodaf/hidpilot
After=systemd-udevd.service

[Service]
Type=simple
# uhid is a module the kernel loads on first use, but the sandbox below needs its sysfs
# directory to exist already ("+" runs this one step outside the sandbox; the "-" on
# ReadWritePaths below lets that step start before the directory exists).
ExecStartPre=+/sbin/modprobe uhid
ExecStart=/usr/local/bin/hidpilot daemon
Restart=on-failure
RestartSec=5

# It needs /dev/uhid (to publish batteries) and the hidraw nodes, nothing else.
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
DeviceAllow=char-hidraw rw
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
# ...except the uevent files of its own mirrors, to announce a new battery to UPower.
ReadWritePaths=-/sys/devices/virtual/misc/uhid
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
