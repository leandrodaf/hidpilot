[Unit]
Description=hidpilot Flow: move mouse and keyboard between computers
Documentation=https://github.com/leandrodaf/hidpilot
# Needs the X session (pointer position) and the clipboard.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/hidpilot-flow run
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
